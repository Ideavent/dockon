{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dockon",
  "version": "0.1.12",
  "identifier": "dev.dockon.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Dockon", "width": 650, "height": 510, "minWidth": 410, "minHeight": 320 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": [{
        "identifier": "main-events",
        "windows": ["main"],
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]
      }]
    }
  },
  "bundle": { "active": false }
}
