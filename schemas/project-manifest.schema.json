{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dockon.dev/schemas/project-manifest-v1.json",
  "title": "Dockon project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "root"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "root": {
      "type": "string",
      "minLength": 1,
      "description": "Existing absolute project directory"
    },
    "executable": {
      "type": "string",
      "description": "Explicit absolute executable path for native launches"
    },
    "args": { "type": "array", "items": { "type": "string" }, "default": [] },
    "provider": { "enum": ["native", "container"], "default": "native" },
    "container": { "$ref": "#/$defs/container" },
    "port": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
    "health": { "$ref": "#/$defs/health" },
    "services": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/service" },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provider": { "const": "container" } },
        "required": ["provider"]
      },
      "then": { "required": ["container"] },
      "else": {
        "required": ["executable"],
        "not": { "required": ["container"] }
      }
    }
  ],
  "$defs": {
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "internal_port"],
      "properties": {
        "engine": { "enum": ["docker", "podman"], "default": "docker" },
        "image": {
          "type": "string",
          "pattern": "^[^\\s-][^\\s]*@sha256:[a-fA-F0-9]{64}$"
        },
        "internal_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "entrypoint": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "health": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "http" },
            "path": { "type": "string", "pattern": "^/[^\\r\\n]*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "tcp" } }
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,32}$",
          "not": { "const": "app" }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "working_dir": {
          "type": "string",
          "default": ".",
          "description": "Canonical path must stay within project root"
        },
        "executable": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "provider": { "enum": ["native", "container"], "default": "native" },
        "container": { "$ref": "#/$defs/container" },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "health": { "$ref": "#/$defs/health" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "provider": { "const": "container" } },
            "required": ["provider"]
          },
          "then": { "required": ["container"] },
          "else": {
            "required": ["executable"],
            "not": { "required": ["container"] }
          }
        }
      ]
    }
  }
}
